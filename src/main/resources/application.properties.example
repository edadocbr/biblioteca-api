spring.application.name=biblioteca-api

# =============
# CONEXIÓN A BD
# =============
spring.datasource.url=jdbc:mysql://localhost:3306/sgbu_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
spring.datasource.username=
spring.datasource.password=
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# update: crea o actualiza las tablas automáticamente al definir las entidades @Entity
# create: elimina las tablas y las vuelve a crear segun lo definido en entidades @Entity
spring.jpa.hibernate.ddl-auto=create

# Dialecto SQL compatible con MySQL 8 e InnoDB
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# Muestra las consultas SQL ejecutadas en la terminal (útil para depurar)
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Servidor
server.port=8080

# CORS (orígenes separados por coma, configurable por variable de entorno)
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:8080}
